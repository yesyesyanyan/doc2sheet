# Copy to .env and fill in. Real environment variables always win over this file.

# Hugging Face token with the "Make calls to Inference Providers" permission
# https://huggingface.co/settings/tokens/new?tokenType=fineGrained
HF_TOKEN=hf_your_token_here

# Optional overrides
# DOC2SHEET_MODEL=google/gemma-4-31B-it
# DOC2SHEET_BASE_URL=https://router.huggingface.co/v1
# DOC2SHEET_MAX_PAGES=3
# DOC2SHEET_JSON_MODE=auto        # auto | schema | object | off

# Fully local & private with Ollama (no key needed):
# DOC2SHEET_BASE_URL=http://localhost:11434/v1
# DOC2SHEET_MODEL=qwen3-vl:2b
# DOC2SHEET_REASONING_EFFORT=none     # turn "thinking" off, or it eats the whole answer budget
# DOC2SHEET_MAX_IMAGE_SIDE=1024       # Ollama's default context is short; smaller images fit

# OpenAI (or any OpenAI-compatible API):
# DOC2SHEET_BASE_URL=https://api.openai.com/v1
# DOC2SHEET_API_KEY=sk-...
# DOC2SHEET_MODEL=<a vision-capable model id>
